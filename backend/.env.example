PORT=5000
NODE_ENV=development

# Database configuration
# Leave empty to automatically fall back to local SQLite database (cavani.db)
#DB_USER=postgres
#DB_HOST=localhost
#DB_DATABASE=cavani
#DB_PASSWORD=yourpassword
#DB_PORT=5432

# Security
JWT_SECRET=supersecretcavani_jwt_key_2026
JWT_EXPIRES_IN=7d

# Mercado Pago Configuration
# Access Token for server-side API processing (keep secret)
MP_ACCESS_TOKEN=your_mercado_pago_access_token_here
